<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <OutputType>WinExe</OutputType>
    <AssemblyName>EflaWin</AssemblyName>
    <RootNamespace>Efla</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ProjectPriFileName>resources.pri</ProjectPriFileName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>EflaWin.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\panel.ico</ApplicationIcon>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <DebugType>embedded</DebugType>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>1.0.0</Version>
    <Company>BLGN Studios</Company>
    <Product>Efla Win</Product>
    <Copyright>Copyright © 2026 BLGN Studios</Copyright>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="System.Management" Version="10.0.15" />
    <Content Include="Assets\*.png;Assets\panel.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Languages\ui.json">
      <LogicalName>Efla.Languages.ui.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
